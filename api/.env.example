PORT=3000
# Local Supabase database started with "supabase start"
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54342/postgres
# Local Supabase auth. The API verifies tokens through SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_URL=http://127.0.0.1:54341
# Only for a hosted project whose dashboard still shows the legacy HS256 JWT secret as current.
# Leave it unset otherwise; the local stack does not need it.
# SUPABASE_JWT_SECRET=
